# Example environment variables (no secrets) — commit this file.

# App
PORT=4000
NODE_ENV=development

# MongoDB
# Use a connection string without credentials here or point to localhost for local dev.
MONGODB_URI=mongodb://127.0.0.1:27017/fitplanner_dev
DATABASE_URL=${MONGODB_URI}

# JWT secret (do not put the real secret here)
JWT_SECRET=your_jwt_secret_here

# Seeding
SEED_COUNT=10

# Logging
LOG_LEVEL=info
# Copy this file to .env and fill in the real values (DO NOT commit secrets)

# MongoDB connection string (Atlas or self-hosted)
# Example: mongodb+srv://<user>:<pass>@cluster0.mongodb.net/fitplanner?retryWrites=true&w=majority
MONGODB_URI=

# JSON Web Token secret for signing tokens (dev: set a simple secret)
JWT_SECRET=dev-secret

# Server port
PORT=4000
