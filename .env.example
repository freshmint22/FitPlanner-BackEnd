# Copy this file to .env and fill in the real values (DO NOT commit secrets)

# MongoDB connection string (Atlas or self-hosted)
# Example: mongodb+srv://<user>:<pass>@cluster0.mongodb.net/fitplanner?retryWrites=true&w=majority
MONGODB_URI=

# JSON Web Token secret for signing tokens (dev: set a simple secret)
JWT_SECRET=dev-secret

# Server port
PORT=4000
