{
  "name": "fitplanner-backend",
  "version": "0.1.0",
  "private": true,
  "description": "FitPlanner backend - members CRUD (Express + TypeScript + Mongoose)",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "seed": "ts-node src/seed.ts",
    "test": "jest --runInBand",
    "test:ci": "jest --ci --runInBand --reporters=default --reporters=jest-junit --coverage",
    "lint": "eslint 'src/**/*.ts' --max-warnings=0",
    "lint:fix": "eslint src/**/*.ts --fix",
    "prepare": "husky install",
    "commitlint": "commitlint --from=$GIT_BASE --to=HEAD || true"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freshmint22/FitPlanner-BackEnd.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jose": "^6.1.3",
    "mongoose": "^7.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.0.0",
    "@commitlint/config-conventional": "^17.0.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.8",
    "@types/mongoose": "^5.11.97",
    "@types/node": "^20.9.0",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "eslint-plugin-security": "^1.7.1",
    "husky": "^8.0.0",
    "jest": "^29.7.0",
    "jest-junit": "^13.0.0",
    "lint-staged": "^16.0.0",
    "mongodb-memory-server": "^8.11.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  },
  "jest-junit": {
    "outputDirectory": "./",
    "outputName": "junit.xml"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "npm run lint:fix",
      "git add"
    ]
  }
}
