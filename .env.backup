# .env - Local development environment variables (DO NOT COMMIT)
# Copy values to your production secret manager or GitHub Actions secrets.

########################
# App
########################
PORT=4000
NODE_ENV=development

########################
# Database (MongoDB)
########################
# Primary connection string (MongoDB Atlas). This contains credentials
# and must be kept secret. Replace with your own Atlas URI or a
# local MongoDB connection when developing offline.
MONGODB_URI=mongodb+srv://fitplanner_user:Valentina12@cluster0.bkt1jta.mongodb.net/fitplanner?appName=Cluster0
# `src/db.ts` falls back to `DATABASE_URL` if `MONGODB_URI` is not set.
DATABASE_URL=${MONGODB_URI}

########################
# Authentication
########################
# Secret used to sign/verify JWT tokens. Replace with a secure value
# before deploying to production.
JWT_SECRET=dev-secret

########################
# Seeding & Feature Flags
########################
# Number of total users to ensure exist when running `npm run seed`.
SEED_COUNT=10

########################
# Logging
########################
LOG_LEVEL=info

########################
# Notes
########################
# This file contains sensitive credentials. Ensure `.env` is listed in
# `.gitignore` (it already is in this project). Do not push this file to
# the repository. For CI, use repository secrets instead of committing
# credentials here.
